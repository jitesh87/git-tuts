{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-jiteshproject-1"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountproject1.dfs.core.windows.net/"
		},
		"ls_AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://project1kv.vault.azure.net/"
		},
		"ls_PostgreSql1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-ancient-dust-b37la82g-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"ls_PostgreSql1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_PostgreSql1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"Daily_Load_Trigger_properties_p_adls_to_adls_bronze_parameters_folderDate": {
			"type": "string",
			"defaultValue": "@convertFromUtc(trigger().scheduledTime,'India Standard Time','yyyyMMdd')"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-jiteshproject-1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"ls_PostgreSql1_properties_typeProperties_server": {
						"value": "[parameters('ls_PostgreSql1_properties_typeProperties_server')]"
					},
					"ls_PostgreSql1_properties_typeProperties_database": {
						"value": "[parameters('ls_PostgreSql1_properties_typeProperties_database')]"
					},
					"ls_PostgreSql1_properties_typeProperties_username": {
						"value": "[parameters('ls_PostgreSql1_properties_typeProperties_username')]"
					},
					"Daily_Load_Trigger_properties_p_adls_to_adls_bronze_parameters_folderDate": {
						"value": "[parameters('Daily_Load_Trigger_properties_p_adls_to_adls_bronze_parameters_folderDate')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}